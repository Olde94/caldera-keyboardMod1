#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// ---------------------------------------------------------------------------------
// |   `  |  1  |  2  |  3  |  4  |  5  |     |  6  |  7  |  8  |  9  |  0  | BKSP |
// |  TAB |  Q  |  W  |  E  |  R  |  T  |     |  Y  |  U  |  I  |  O  |  P  |  \   |
// | CAPS |  A  |  S  |  D  |  F  |  G  |     |  H  |  J  |  K  |  L  |  ;  |  ENT |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |     |  N  |  M  |  ,  |  .  |  /  | APOS |
// | CTRL | GUI | ALT | Lay3| Lay2| SPC |     | SPC | LOW |LARW |DARW |UARW | RARW |
                        bindings = <
   &kp ESC    &kp N1    &kp N2    &kp N3     &kp N4     &kp N5               &kp N6     &kp N7  &kp N8     &kp N9    &kp N0    &kp BSPC
   &kp TAB    &kp Q     &kp W     &kp E      &kp R      &kp T                &kp Y      &kp U   &kp I      &kp O     &kp P     &kp LBKT
   &kp CAPS   &kp A     &kp S     &kp D      &kp F      &kp G                &kp H      &kp J   &kp K      &kp L     &kp SEMI  &kp APOS
   &kp LSHFT  &kp Z     &kp X     &kp C      &kp V      &kp B                &kp N      &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
   &kp LCTRL  &kp LGUI  &kp LALT  &tog 3     &mo 2      &kp SPACE           &kp SPACE  &mo 1   &kp LEFT   &kp RIGHT &kp RCTRL &kp RET
                        >;
                };
                lower_layer {
// ------------------------------------------------------------------------------------------------------------
// | ESC   |  +    |   2   |   £   |  $    |       |          |      |        | CLEAR |   /   |   *   | DELETE|
// | BT1   |  ?    |   @   |  UP   |       |       |          |      |        |   7   |   8   |   9   |   -   |
// | BT2   |       |  LEFT | DOWN  | RIGHT |       |          |      |        |   4   |   5   |   6   |   +   |
// | BT3   |  <    |   >   |  ~    |       |       |          |      |        |   1   |   2   |   3   | BKSP  |
// | BTCLR |       |       |       |  RALT |  SPC  |          | SPC  | reserv |   0   |   ,   |   .   | Enter |
                        bindings = <
   &kp ESC         &kp PLUS       &kp N2            &kp N3         &kp N4         &trans              &trans    &trans    &kp CLEAR &kp LS(7)   &kp LS(BSLH)  &kp DEL
   &kp TAB         &kp LS(PLUS)   &kp RA(N2)        &kp RA(N3)     &kp RA(N4)     &trans              &trans    &trans    &kp N7    &kp N8      &kp N9        &kp MINUS
   &kp CAPS        &trans         &kp LEFT          &kp DOWN       &kp RIGHT      &kp RPAR            &trans    &trans    &kp N4    &kp N5      &kp N6        &kp PLUS
   &kp LSHFT       &kp LESS_THAN  &kp GREATER_THAN  &kp TILDE      &trans         &trans              &trans    &trans    &kp N1    &kp N2      &kp N3        &kp BSPC
   &kp LCTRL       &kp LGUI       &kp LALT          &trans         &kp RALT       &kp SPACE           &kp SPACE &trans    &kp N0    &kp COMMA   &kp DOT       &kp RET
                        >;
                };
                raise_layer {
// ------------------------------------------------------------------------------------------------------------
// |  F1   |  F2   |  F3   |  F4   |  F5   |  F6   |          |   F7  |    F8 |   F9  |   F10 |  F11  |  F12  |
// | BT1   |       |       |       |       |       |          |       |    [  |   ]   |   {   |    }  |   '   |
// | BT2   |       |       |       |       |       |          |       |       |       |   \   |    |  |   ~   |
// | BT3   |       |       |       |       |       |          |       |       |       |       |   UP  |       | 
// | BTCLR |  ALT  |       |       |       |       |          |       |       |       | LEFT  |  DOWN | RIGHT |
                        bindings = <
   &kp F1         &kp F2   &kp F3   &kp F4      &kp F5    &kp F6                 &kp F7    &kp F8    &kp F9   &kp F10  &kp F11  &kp F12
   &trans         &trans   &trans   &trans      &trans    &trans                 &trans    &kp LBKT  &kp RBKT &kp LBRC &kp RBRC &kp APOS
   &trans         &trans   &trans   &trans      &trans    &trans                 &trans    &trans    &trans   &kp BSLH &kp PIPE &kp GRAVE
   &kp LSHFT      &trans   &trans   &trans      &trans    &trans                 &trans    &trans    &trans   &trans   &kp UP   &trans
   &kp LCTRL      &kp LALT &trans   &trans      &trans    &trans                 &trans    &trans    &trans   &kp LEFT &kp DOWN &kp RIGHT
                        >;
                };
                static_Layer {
// ------------------------------------------------------------------------------------------------------------
// |  t    |  e    |   s   |  t    |  l    |  i    |          |   n   |    e  |   s   |   1   |  2    |  3    |
// |       |       |       |       |       |       |          |       |    [  |   ]   |   {   |    }  |   '   |
// |       |       |       |       |       |       |          |       |       |       |   \   |    |  |   ~   |
// | SHFT  |       |       |       |       |       |          |       |       |       |       |   UP  |       | 
// | CTRL  |  ALT  |       |  Lay3 |       |       |          |       |       |       | LEFT  |  DOWN | RIGHT |
                        bindings = <
   &kp T          &kp E    &kp S    &kp T       &kp L     &kp I                  &kp N     &kp E     &kp S    &kp N1   &kp N2   &kp N3
   &bt BT_SEL 0   &trans   &trans   &trans      &trans    &trans                 &trans    &kp LBKT  &kp RBKT &kp LBRC &kp RBRC &kp APOS
   &bt BT_SEL 1   &trans   &trans   &trans      &trans    &trans                 &trans    &trans    &trans   &kp BSLH &kp PIPE &kp GRAVE
   &bt BT_SEL 2   &trans   &trans   &trans      &trans    &trans                 &trans    &trans    &trans   &trans   &kp UP   &trans
   &bt BT_CLR     &trans   &trans   &tog 3      &trans    &trans                 &trans    &trans    &trans   &kp LEFT &kp DOWN &kp RIGHT
                        >;
                };

        };
};

